@page
@model BarbershopCrm.Web.Pages.Staff.ProfileModel
@{
    ViewData["Title"] = "Мой профиль";
}

<div class="container mt-5">
    <div class="eyebrow">Кабинет мастера</div>
    <h2 class="mt-2 mb-2">Мой профиль</h2>
    <p class="text-muted mb-4">
        @Model.FullName &middot; <span class="text-muted">@Model.BranchName</span>
    </p>

    <partial name="_StaffNav" />

    <div class="grid grid-cols-4 mb-4">
        <div class="card kpi-card">
            <div class="eyebrow">Завершено · 30 д.</div>
            <div class="kpi-value">@Model.CompletedLast30</div>
        </div>
        <div class="card kpi-card">
            <div class="eyebrow">Выручка · 30 д.</div>
            <div class="kpi-value">@Model.RevenueLast30.ToString("0") ₽</div>
        </div>
        <div class="card kpi-card">
            <div class="eyebrow">Отмен / no-show · 30 д.</div>
            <div class="kpi-value">@Model.CancelledLast30 / @Model.NoShowLast30</div>
        </div>
        <div class="card kpi-card">
            <div class="eyebrow">Предстоит</div>
            <div class="kpi-value">@Model.UpcomingCount</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="notice notice-success mb-3">
            <p class="mb-0">@Model.StatusMessage</p>
        </div>
    }

    <form method="post" class="card" style="max-width:640px;">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"
             style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

        <div class="field">
            <label asp-for="Input.Position">Должность</label>
            <input asp-for="Input.Position" class="form-control" />
            <span asp-validation-for="Input.Position" class="text-danger"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Bio">О себе</label>
            <textarea asp-for="Input.Bio" class="form-control" rows="6"
                      placeholder="Коротко расскажите о своём опыте и стиле работы"></textarea>
            <span asp-validation-for="Input.Bio" class="text-danger"></span>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Сохранить</button>
        </div>
    </form>

    <p class="text-muted mt-4" style="font-size:.85rem;">
        Смену специализации, филиала или активности профиля настраивает владелец.
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
