@page
@model BarbershopCrm.Web.Pages.Booking.ServiceModel
@{
    ViewData["Title"] = "Запись на приём — выбор услуги";
}

<partial name="_BookingSteps" model="2" />

<h1 class="mb-1">Выбор услуги</h1>
@if (Model.Branch is not null)
{
    <p class="text-muted">Филиал: @Model.Branch.Name</p>
}

<div class="list-group mt-3">
    @foreach (var service in Model.Services)
    {
        <a class="list-group-item list-group-item-action"
           asp-page="Master"
           asp-route-branchId="@Model.BranchId"
           asp-route-serviceId="@service.ServiceId">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="mb-1">@service.Name</h5>
                    @if (!string.IsNullOrWhiteSpace(service.Description))
                    {
                        <p class="mb-1 text-muted">@service.Description</p>
                    }
                    <small class="text-muted">@service.DurationMinutes мин.</small>
                </div>
                <div class="text-end ms-3">
                    <span class="fs-5 fw-semibold">@service.Price.ToString("0") ₽</span>
                </div>
            </div>
        </a>
    }
</div>

<a class="btn btn-link mt-3" asp-page="Index">← Назад к выбору филиала</a>
