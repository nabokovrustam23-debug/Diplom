@model int
@{
    var steps = new[]
    {
        "Филиал",
        "Услуга",
        "Мастер",
        "Дата и время",
        "Контакты"
    };
}

<ol class="booking-steps">
    @for (var i = 0; i < steps.Length; i++)
    {
        var num = i + 1;
        string cls = num == Model ? "is-active" : (num < Model ? "is-done" : "");
        <li class="@cls"><span class="num">@($"0{num}")</span>@steps[i]</li>
    }
</ol>
