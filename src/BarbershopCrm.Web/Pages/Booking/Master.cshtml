@page
@model BarbershopCrm.Web.Pages.Booking.MasterModel
@{
    ViewData["Title"] = "Запись на приём — выбор мастера";
}

<partial name="_BookingSteps" model="3" />

<h1 class="mb-1">Выбор мастера</h1>
@if (Model.Branch is not null && Model.Service is not null)
{
    <p class="text-muted">@Model.Branch.Name · @Model.Service.Name (@Model.Service.DurationMinutes мин.)</p>
}

<div class="row g-3 mt-2">
    @foreach (var master in Model.Masters)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@master.Persona.LastName @master.Persona.FirstName</h5>
                    <p class="card-text text-muted mb-1">@master.Position</p>
                    @if (!string.IsNullOrWhiteSpace(master.Bio))
                    {
                        <p class="card-text small">@master.Bio</p>
                    }
                    <a class="btn btn-primary mt-auto"
                       asp-page="Slot"
                       asp-route-branchId="@Model.BranchId"
                       asp-route-serviceId="@Model.ServiceId"
                       asp-route-masterId="@master.MasterId">
                        Выбрать
                    </a>
                </div>
            </div>
        </div>
    }
    @if (Model.Masters.Count == 0)
    {
        <div class="col-12">
            <div class="alert alert-warning">
                В выбранном филиале нет мастеров, оказывающих эту услугу.
            </div>
        </div>
    }
</div>

<a class="btn btn-link mt-3"
   asp-page="Service"
   asp-route-branchId="@Model.BranchId">← Назад к выбору услуги</a>
