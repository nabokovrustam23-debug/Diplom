@page
@using BarbershopCrm.Infrastructure.Identity
@model BarbershopCrm.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Пользователи и роли";
}

<div class="container mt-5">
    <div class="eyebrow">Система / Роли</div>
    <h2 class="mt-2 mb-2">Пользователи</h2>
    <p class="text-muted mb-4">Список всех учётных записей сети с текущими ролями. Смена роли — немедленно, без перезапуска.</p>

    <partial name="../_AdminNav" />

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="notice notice-success mb-3">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ResetPasswordValue))
    {
        <div class="notice notice-warn mb-3">
            <strong>Временный пароль для @Model.ResetPasswordEmail:</strong>
            <code class="mono" style="font-size:1.05rem;background:#fff3d6;padding:2px 8px;border-radius:6px;margin:0 6px;">@Model.ResetPasswordValue</code>
            <span class="text-muted" style="font-size:.85rem;">Скопируйте сейчас — после обновления страницы пароль больше не отобразится.</span>
        </div>
    }

    <form method="get" class="filter-form mb-3">
        <div class="filter-row">
            <div class="field">
                <label>Роль</label>
                <select name="RoleFilter" onchange="this.form.submit()">
                    <option value="">Любая</option>
                    @foreach (var r in BarbershopCrm.Web.Pages.Admin.Users.IndexModel.AllRoles)
                    {
                        <option value="@r" selected="@(Model.RoleFilter == r)">
                            @BarbershopCrm.Web.Pages.Admin.Users.IndexModel.RoleLabel(r)
                        </option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Поиск</label>
                <input type="text" name="Q" value="@Model.Q" placeholder="email / имя / телефон" />
            </div>
            <div class="field">
                <label>&nbsp;</label>
                <button type="submit" class="btn btn-outline btn-sm">Применить</button>
            </div>
            @if (!string.IsNullOrEmpty(Model.RoleFilter) || !string.IsNullOrEmpty(Model.Q))
            {
                <div class="field">
                    <label>&nbsp;</label>
                    <a asp-page="Index" class="btn btn-ghost btn-sm">Сбросить</a>
                </div>
            }
        </div>
    </form>

    <table class="data-table">
        <thead>
            <tr>
                <th>Email</th>
                <th>ФИО</th>
                <th>Телефон</th>
                <th>Роль</th>
                <th class="actions">Сменить роль</th>
                <th class="actions">Пароль</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Users)
            {
                <tr>
                    <td class="mono">@u.Email</td>
                    <td>@u.FullName</td>
                    <td class="mono text-muted">@u.Phone</td>
                    <td>@u.RoleLabel</td>
                    <td class="actions">
                        <form method="post" asp-page-handler="SetRole" asp-route-userId="@u.UserId" style="display:inline-flex;gap:6px;">
                            <select name="role" class="form-select" style="min-width:160px;">
                                @foreach (var r in BarbershopCrm.Web.Pages.Admin.Users.IndexModel.AllRoles)
                                {
                                    <option value="@r" selected="@(u.RoleCode == r)">@BarbershopCrm.Web.Pages.Admin.Users.IndexModel.RoleLabel(r)</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-outline btn-sm" title="Применить роль">Сохранить</button>
                        </form>
                    </td>
                    <td class="actions">
                        <form method="post" asp-page-handler="ResetPassword" asp-route-userId="@u.UserId"
                              onsubmit="return confirm('Сбросить пароль для @u.Email? Будет сгенерирован временный пароль.');"
                              style="display:inline;">
                            <button type="submit" class="btn btn-ghost btn-sm" title="Сгенерировать временный пароль">Сбросить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <details class="card mt-5">
        <summary style="cursor:pointer;font-family:var(--serif);font-size:1.1rem;color:var(--text);">+ Пригласить пользователя</summary>
        <p class="text-muted mt-2" style="font-size:.88rem;">
            Создать новую учётную запись с указанной ролью. CRM сгенерирует временный
            пароль и покажет его один раз — передайте его сотруднику любым защищённым каналом.
        </p>
        <form method="post" asp-page-handler="Invite" class="grid grid-cols-2 mt-3" style="gap:12px;">
            <div asp-validation-summary="ModelOnly" class="notice notice-danger" style="grid-column:1/-1;@(ViewData.ModelState.ErrorCount == 0 ? "display:none" : "")"></div>
            <div class="field">
                <label asp-for="Invite.LastName">Фамилия</label>
                <input asp-for="Invite.LastName" />
                <span asp-validation-for="Invite.LastName" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Invite.FirstName">Имя</label>
                <input asp-for="Invite.FirstName" />
                <span asp-validation-for="Invite.FirstName" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Invite.Email">E-mail</label>
                <input asp-for="Invite.Email" type="email" />
                <span asp-validation-for="Invite.Email" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Invite.Phone">Телефон</label>
                <input asp-for="Invite.Phone" type="tel" placeholder="+7 (999) 000-00-00" />
                <span asp-validation-for="Invite.Phone" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Invite.Role">Роль</label>
                <select asp-for="Invite.Role">
                    @foreach (var r in BarbershopCrm.Web.Pages.Admin.Users.IndexModel.AllRoles)
                    {
                        <option value="@r">@BarbershopCrm.Web.Pages.Admin.Users.IndexModel.RoleLabel(r)</option>
                    }
                </select>
            </div>
            <div class="field" style="align-self:end;">
                <button type="submit" class="btn btn-primary">Создать</button>
            </div>
        </form>
    </details>
</div>
