@page "{id:int}"
@model BarbershopCrm.Web.Pages.Admin.Masters.EditModel
@{
    ViewData["Title"] = "Редактирование мастера";
}

<div class="container mt-5">
    <div class="eyebrow">Команда / Мастера</div>
    <h2 class="mt-2 mb-5">Изменение мастера</h2>

    <form method="post" class="col-form" style="max-width:640px;" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="notice notice-danger"
             style="@(ViewData.ModelState.ErrorCount == 0 ? "display:none" : "")"></div>

        <h5 class="mt-2 mb-2">Персональные данные</h5>
        <div class="grid grid-cols-2">
            <div class="field"><label asp-for="Input.LastName">Фамилия</label><input asp-for="Input.LastName" /><span asp-validation-for="Input.LastName" class="text-danger"></span></div>
            <div class="field"><label asp-for="Input.FirstName">Имя</label><input asp-for="Input.FirstName" /><span asp-validation-for="Input.FirstName" class="text-danger"></span></div>
        </div>
        <div class="field"><label asp-for="Input.MiddleName">Отчество</label><input asp-for="Input.MiddleName" /></div>
        <div class="grid grid-cols-2">
            <div class="field"><label asp-for="Input.Phone">Телефон</label><input asp-for="Input.Phone" type="tel" /><span asp-validation-for="Input.Phone" class="text-danger"></span></div>
            <div class="field"><label asp-for="Input.Email">E-mail</label><input asp-for="Input.Email" type="email" /></div>
        </div>
        <div class="grid grid-cols-2">
            <div class="field">
                <label asp-for="Input.Gender">Пол</label>
                <select asp-for="Input.Gender">
                    <option value="Male">Мужской</option>
                    <option value="Female">Женский</option>
                    <option value="Other">Другой</option>
                </select>
            </div>
            <div class="field"><label asp-for="Input.BirthDate">Дата рождения</label><input asp-for="Input.BirthDate" type="date" /></div>
        </div>

        <h5 class="mt-4 mb-2">Профессиональные данные</h5>
        <div class="grid grid-cols-2">
            <div class="field"><label asp-for="Input.Position">Должность</label><input asp-for="Input.Position" /><span asp-validation-for="Input.Position" class="text-danger"></span></div>
            <div class="field"><label asp-for="Input.HireDate">Дата приёма</label><input asp-for="Input.HireDate" type="date" /></div>
        </div>
        <div class="field"><label asp-for="Input.Bio">Биография</label><textarea asp-for="Input.Bio" rows="3"></textarea></div>
        <div class="field">
            <label asp-for="Input.AvatarFile">Аватар (JPG/PNG/WEBP, до 2 МБ)</label>
            @if (!string.IsNullOrEmpty(Model.CurrentAvatarPath))
            {
                <div class="mb-1"><img src="@Model.CurrentAvatarPath" alt="" style="width:96px;height:96px;border-radius:12px;object-fit:cover;border:1px solid var(--border);" /></div>
            }
            <input asp-for="Input.AvatarFile" type="file" accept="image/jpeg,image/png,image/webp" />
            <span asp-validation-for="Input.AvatarFile" class="text-danger"></span>
            <p class="text-muted mt-1" style="font-size:.85rem;">Загрузка нового файла заменит текущий аватар.</p>
        </div>
        <div class="field">
            <label style="text-transform:none;letter-spacing:0;color:var(--text);font-family:var(--sans);font-size:0.95rem;">
                <input type="checkbox" asp-for="Input.IsActive" style="width:auto;margin-right:8px;vertical-align:middle;" />
                Активный мастер
            </label>
        </div>

        <h5 class="mt-4 mb-2">Филиал</h5>
        <div class="field">
            <select asp-for="Input.BranchId" asp-items="@Model.BranchOptions">
                <option value="">— выберите филиал —</option>
            </select>
            <span asp-validation-for="Input.BranchId" class="text-danger"></span>
            <p class="text-muted mt-1" style="font-size:.85rem;">Один мастер закреплён за одним филиалом.</p>
        </div>

        <h5 class="mt-4 mb-2">Услуги</h5>
        <div class="field">
            <select asp-for="Input.ServiceIds" asp-items="@Model.ServiceOptions" multiple size="@Math.Min(8, Math.Max(3, Model.ServiceOptions.Count))"></select>
        </div>

        <div class="flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a asp-page="Index" class="btn btn-outline">Отмена</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
