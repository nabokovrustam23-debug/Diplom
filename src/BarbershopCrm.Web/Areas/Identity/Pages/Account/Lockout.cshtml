@page
@model LockoutModel
@{
    ViewData["Title"] = "Вход заблокирован";
}

<section class="container">
    <div class="identity-shell">
        <div class="identity-ornament">✦ ✦ ✦</div>
        <h1>Вход временно заблокирован</h1>
        <p class="identity-sub">Превышено количество попыток входа. Попробуйте снова через несколько минут.</p>
        <div class="text-center mt-3">
            <a class="btn btn-primary" asp-page="/Index" asp-area="">На главную</a>
        </div>
    </div>
</section>
