@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Сменить пароль";
}

<section class="container mt-4">
    <ul class="manage-nav">
        <li><a asp-page="./Index">Профиль</a></li>
        <li><a asp-page="./ChangePassword" class="active">Сменить пароль</a></li>
    </ul>

    <h3>Смена пароля</h3>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
    }

    <form id="change-password-form" method="post" class="col-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

        <div class="field">
            <label asp-for="Input.OldPassword">Текущий пароль</label>
            <input asp-for="Input.OldPassword" class="form-control" type="password" autocomplete="current-password" />
            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
        </div>

        <div class="field">
            <label asp-for="Input.NewPassword">Новый пароль</label>
            <input asp-for="Input.NewPassword" class="form-control" type="password" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        </div>

        <div class="field">
            <label asp-for="Input.ConfirmPassword">Повторите новый пароль</label>
            <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Обновить пароль</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
