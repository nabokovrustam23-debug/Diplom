@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Восстановление пароля";
}

<section class="container">
    <div class="identity-shell">
        <div class="identity-ornament">✦ ✦ ✦</div>
        <h1>Забыли пароль?</h1>
        <p class="identity-sub">
            Восстановление пароля по e-mail в данной версии не подключено
            (нет SMTP-сервиса). Обратитесь к администратору сети, чтобы он
            сбросил вам пароль вручную.
        </p>
        <div class="text-center mt-3">
            <a class="btn btn-primary" asp-page="./Login">Вернуться ко входу</a>
        </div>
    </div>
</section>
